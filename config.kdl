input {
    keyboard {
        xkb {
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.3
        accel-profile "adaptive"
    }
    mouse {
    }
    trackpoint {
    }
    focus-follows-mouse max-scroll-amount="0%"
}
animations {
    slowdown 0.7999999999999997
    window-open {
        duration-ms 260
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float slide_px = (1.0 - p) * 60.0;
                float slide_geo = slide_px / max(size_geo.x, 1.0);
                float scale = 0.985 + 0.015 * p;
                vec2 uv = coords_geo.xy;
                uv -= vec2(0.5, 0.5);
                uv /= scale;
                uv += vec2(0.5, 0.5);
                uv.y -= slide_geo;
                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                color *= p;
                return color;
            }
        "
    }
    window-close {
        duration-ms 180
        curve "cubic-bezier" 0.32 0.0 0.67 0.0
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float inv = 1.0 - p;
                float slide_px = p * 40.0;
                float slide_geo = slide_px / max(size_geo.x, 1.0);
                float scale = 1.0 - 0.012 * p;
                vec2 uv = coords_geo.xy;
                uv -= vec2(0.5, 0.5);
                uv /= scale;
                uv += vec2(0.5, 0.5);
                uv.y -= slide_geo;
                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                color *= inv;
                return color;
            }
        "
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=720 epsilon=0.0001
        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);
                vec2 uv = coords_curr_geo.xy;
                float edge =
                    min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
                float vignette = smoothstep(0.0, 0.06, edge);
                color.rgb *= mix(0.985, 1.0, vignette);
                return color;
            }
        "
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=760 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=640 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=820 epsilon=0.001
    }
    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=560 epsilon=0.01
    }
    screenshot-ui-open {
        duration-ms 220
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=620 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=680 epsilon=0.001
    }
}
cursor {
    xcursor-theme "Breeze_Light"
    xcursor-size 24
}
spawn-at-startup "noctalia"

blur {
    passes 2
    offset 1.8
    noise 0.03
    saturation 1.3
}
environment {
    GDK_BACKEND "wayland,x11"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    XDG_MENU_PREFIX "plasma-"
    _JAVA_AWT_WM_NONREPARENTING "1"
    NO_AT_BRIDGE "1"
}
output "eDP-1" {
    variable-refresh-rate
    mode "1920x1080@60.008"
    scale 1.0
    transform "normal"
    position x=0 y=0
}
/-output "eDP-1" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=1280 y=0
}
layout {
    background-color "transparent"
    gaps 4
    center-focused-column "never"
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        off
        width 2
    }
    border {
        off
        width 0
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {
    }
}
hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    match app-id="brave-origin" title="Picture in picture"
    open-floating true
    default-column-width { fixed 640; }
    default-window-height { fixed 360; }
}
/-window-rule {
    match app-id=r"^org\.keepassxc\.KeePassXC$"
    match app-id=r"^org\.gnome\.World\.Secrets$"
    block-out-from "screen-capture"
}
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}
window-rule {
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}
window-rule {
    match app-id=r"^org\.gnome\."
    draw-border-with-background false
    geometry-corner-radius 5
    clip-to-geometry true
}
window-rule {
    match app-id="Alacritty"
    draw-border-with-background false
}
window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.NautilusPreviewer"
    match app-id="org.gnome.Snapshot"
    match app-id="auto-cpufreq"
    match app-id="system-config-printer"
    match app-id="nwg-look"
    match app-id="bssh"
    match app-id="nm-connection-editor"
    match app-id="bvnc"
    match app-id="avahi-discover"
    match app-id="lstopo"
    match app-id="qv4l2"
    match title="btop"
    open-floating true
}
window-rule {
    match app-id="io.github.nozwock.Packet"
    match app-id="qt6ct"
    match app-id="qalculate"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 600; }
}
window-rule {
    match app-id="org.gnome.seahorse.Application"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 700; }
}
window-rule {
    match app-id="pavucontrol"
    match app-id="org.gnome.SimpleScan"
    match app-id="com.oppzippy.OpenSCQ30"
    match app-id="org.gnome.FileRoller"
    match app-id="io.gitlab.adhami3310.Impression"
    match app-id="org.kde.filelight"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
}
window-rule {
    match is-active=false
    opacity 0.75
    shadow {
        on
        softness 0
        spread 0
        offset x=0 y=0
        draw-behind-window true
        color "#000000D0"
    }
}
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}
overview {
    workspace-shadow {
        // off
    }
}
debug {
  honor-xdg-activation-with-invalid-serial
}
gestures {
    hot-corners {
        off
    }
}
include "binds.kdl"
include "noctalia.kdl" 
