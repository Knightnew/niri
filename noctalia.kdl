layout {

    focus-ring {
        active-color   "#b8c3ff"
        inactive-color "#121318"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b8c3ff"
        inactive-color "#121318"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b8c3ff"
        inactive-color "#374379"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b8c3ff80"
    }
}

recent-windows {
    highlight {
        active-color "#b8c3ff"
        urgent-color "#ffb4ab"
    }
}
